# Salin ke .env lalu isi. Hanya dibaca di api/core/config.py.

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webkarbon
DB_USER=postgres
DB_PASSWORD=

# JWT — WAJIB, minimal 32 byte. Buat: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRES=60      # menit
JWT_REFRESH_EXPIRES=7      # hari

# Upload foto (wajah pegawai, selfie absen)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
